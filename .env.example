NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins, or * for any (not allowed in production)
CORS_ORIGIN=*
# Number of proxies in front of the API (0 locally, 1 behind a load balancer)
TRUST_PROXY=0

# Supabase project: Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only, never in the mobile app. The API's only way into the database: it calls the
# catalog/reviews tables and the app_* database functions with this key.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Secrets: 32 random bytes each, base64, all different. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing DATA_ENCRYPTION_KEY or BLIND_INDEX_KEY makes stored emails and phones unreadable.
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Optional token lifetimes (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_IDLE_DAYS=30
# SESSION_MAX_DAYS=90

# How OTP codes are delivered. "console" logs them (development only; refused in production).
OTP_DELIVERY=console
# Development/testing only: every OTP code is this fixed value, e.g. 1234 (refused in production)
# OTP_TEST_CODE=1234

# Swagger UI at /api/docs (default: on except in production)
# API_DOCS=true
