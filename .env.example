NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins, or * for any (not allowed in production)
CORS_ORIGIN=*
# Number of proxies in front of the API (0 locally, 1 behind a load balancer)
TRUST_PROXY=0

# Supabase project: Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# Server only. Bypasses Row Level Security; never ship it in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Supabase: Connect -> Session pooler -> URI (replace [YOUR-PASSWORD] with the database password)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Secrets: 32 random bytes each, base64, all different. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing DATA_ENCRYPTION_KEY or BLIND_INDEX_KEY makes stored emails and phones unreadable.
JWT_ACCESS_SECRET=
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Optional token lifetimes (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_IDLE_DAYS=30
# SESSION_MAX_DAYS=90

# How OTP codes are delivered. "console" logs them (development only; refused in production).
OTP_DELIVERY=console
